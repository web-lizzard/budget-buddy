# Classic GitHub PAT with read:packages and repo.
# Fine-grained tokens do not work with GitHub Packages.
# The devcontainer installs @web-lizzard/ordo with GITHUB_PACKAGES_TOKEN.
# Every zsh in the container exports this file and, when GITHUB_TOKEN is unset,
# reuses the same value as GITHUB_TOKEN so `ordo add` / `ordo update` can pull skills.
GITHUB_PACKAGES_TOKEN=ghp_your_token_here
